global:
  scrape_interval: 15s
  evaluation_interval: 15s

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - localhost:9093

rule_files:
  - "/etc/prometheus/alert_rules.yml"

scrape_configs:
  - job_name: "prometheus"
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: "node_exporter"
    static_configs:
      - targets:
          - "localhost:9100"
{% for host in groups['devops'] %}
{% if host != groups['monitoring'][0] %}
          - "{{ host }}:9100"
{% endif %}
{% endfor %}

  - job_name: "microblog"
    static_configs:
      - targets:
{% for host in groups['appserver'] %}
          - "{{ host }}:8000"
{% endfor %}
    metrics_path: /metrics
