  "outputs": {
    "hosts": {
      "type": "object",
      "value": {
        "appserver": {
          "private_ip": "10.0.1.4",
          "public_ip": "[reference(resourceId('Microsoft.Network/publicIPAddresses','kmom04-appserver-ip'),'2023-09-01').ipAddress]"
        },
        "database": {
          "private_ip": "10.0.1.5",
          "public_ip": "[reference(resourceId('Microsoft.Network/publicIPAddresses','kmom04-database-ip'),'2023-09-01').ipAddress]"
