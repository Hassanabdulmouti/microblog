        "[resourceId('Microsoft.Network/networkSecurityGroups', 'kmom04-loadbalancer-sg')]",
        "[resourceId('Microsoft.Network/publicIPAddresses', 'kmom04-loadbalancer-ip')]"
      ],
      "tags": {
        "StudentId": "haad23",
