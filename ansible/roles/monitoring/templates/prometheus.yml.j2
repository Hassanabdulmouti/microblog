global:
  scrape_interval: 15s
  evaluation_interval: 15s
alerting:
  alertmanagers:
    - static_configs:
        - targets: ["{{ prometheus_alertmanager_target | default('localhost:9093') }}"]
rule_files:
  - "/etc/prometheus/alert_rules.yml"
scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["{{ prometheus_self_target | default('localhost:9090') }}"]
  - job_name: node_exporter
    static_configs:
      - targets:
{% for host in groups['devops'] | unique %}
          - "{{ 'localhost' if host in groups.get('monitoring', []) else hostvars[host].monitoring_address | default(host) }}:9100"
{% endfor %}
  - job_name: microblog
    metrics_path: /metrics
    static_configs:
      - targets:
{% for host in groups['appserver'] %}
          - "{{ hostvars[host].monitoring_address | default(host) }}:{{ microblog_metrics_port | default(8000) }}"
{% endfor %}
