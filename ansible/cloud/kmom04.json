      "apiVersion": "2023-09-01",
      "name": "kmom04-loadbalancer-ip",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard"
      },
      "tags": {
        "StudentId": "haad23",
        "Course": "kmom04"
      },
      "properties": {
        "publicIPAllocationMethod": "Static",
        "dnsSettings": {
          "domainNameLabel": "[parameters('dnsLabel')]"
        }
      }
    },
