      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', 'kmom04-database-nic')]"
      ],
      "tags": {
        "StudentId": "haad23",
        "Course": "kmom04",
        "Type": "database"
      },
      "properties": {
        "hardwareProfile": {
          "vmSize": "[parameters('vmSize')]"
        },
        "storageProfile": {
          "imageReference": {
